# These values are embedded in the built client app. Never put secrets or private API keys here.
VITE_SUPPORT_EMAIL=info@aralpars.com
VITE_TELEGRAM_HANDLE=VOLTGuardPro_Aralparspaya
VITE_WHATSAPP_USERNAME=@VoltGuardPro_A.P.P

# Replace store search fallbacks with the published app listings before release.
VITE_IOS_APP_STORE_URL=https://apps.apple.com/search?term=VoltGuard%20Pro
VITE_ANDROID_PLAY_STORE_URL=https://play.google.com/store/search?q=VoltGuard%20Pro&c=apps

# Native apps need the publisher's HTTPS manifest URL to check for newer releases.
# The PWA checks public/app-version.json on its own origin.
VITE_APP_UPDATE_MANIFEST_URL=

# Set the publisher's actual payment URLs and wallet addresses before enabling donations.
VITE_PAYPAL_PAYMENT_URL=
VITE_REVOLUT_PAYMENT_URL=https://revolut.me/voltguard
VITE_BITCOIN_WALLET=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
VITE_USDT_TRC20_WALLET=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

